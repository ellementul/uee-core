  await later(1)

  t.is(member.tools.LoggingTree.getNodeAttr(member.uid(), "name"), "LoggerMember")
  t.is(member.tools.LoggingTree.getNodeAttr(member2.uid(), "name"), "LoggerMember" + member2.uid()[0])
})
